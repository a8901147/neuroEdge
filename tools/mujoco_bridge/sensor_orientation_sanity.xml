<mujoco model="sensor_orientation_sanity">
  <!-- Deliberately the simplest possible scene (2026-09-05): no arm, no
       joints chained to anything, no calibration, no oblique-basis math --
       just two free-floating shapes, each driven directly by ONE sensor's
       raw accelerometer vector via the shortest-rotation-from-world-up
       quaternion (see sensor_orientation_sanity.py). Purpose: answer "can
       a physical sensor tilt be faithfully reflected as a MuJoCo
       orientation at all" before trusting any of the arm-specific
       calibration/decode pipeline built on top of that same raw data. -->
  <option gravity="0 0 0"/>

  <asset>
    <texture type="2d" name="grid" builtin="checker" rgb1=".15 .15 .15" rgb2=".25 .25 .25" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="4 4" reflectance=".1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" diffuse="1 1 1"/>
    <geom type="plane" size="2 2 0.1" material="grid"/>

    <!-- SHOULDER: a flat square plate. Thin box, not a cube -- a perfect
         cube's rotation is ambiguous to the eye at 90deg increments, a
         plate's is not. RGB stripes on the top face mark a fixed
         in-plate direction so the "which way is this pointing" question
         has an unambiguous visual answer even head-on. -->
    <body name="shoulder_shape" pos="-0.5 0 1">
      <joint name="shoulder_ball" type="ball"/>
      <geom type="box" size="0.25 0.25 0.03" rgba="0.75 0.75 0.78 1"/>
      <geom type="box" size="0.22 0.04 0.032" pos="0.1 0 0" rgba="0.9 0.15 0.15 1"/>
      <geom type="box" size="0.04 0.22 0.032" pos="0 0.1 0" rgba="0.15 0.55 0.9 1"/>
    </body>

    <!-- ELBOW: a flat disc. Same reasoning -- a perfect sphere shows no
         rotation at all; a disc's face normal makes tilt obvious, and the
         same red/blue stripe convention marks in-plane direction. -->
    <body name="elbow_shape" pos="0.5 0 1">
      <joint name="elbow_ball" type="ball"/>
      <geom type="cylinder" size="0.25 0.03" rgba="0.75 0.75 0.78 1"/>
      <geom type="box" size="0.22 0.04 0.032" pos="0.1 0 0" rgba="0.9 0.15 0.15 1"/>
      <geom type="box" size="0.04 0.22 0.032" pos="0 0.1 0" rgba="0.15 0.55 0.9 1"/>
    </body>
  </worldbody>
</mujoco>
