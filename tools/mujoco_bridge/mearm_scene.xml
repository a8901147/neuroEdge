  </worldbody>
  <contact>
    <exclude body1="base_link" body2="column_link"/>
    <exclude body1="column_link" body2="upper_arm_link"/>
    <exclude body1="upper_arm_link" body2="forearm_link"/>
    <exclude body1="forearm_link" body2="tool_link"/>
    <exclude body1="tool_link" body2="jaw_link"/>
  </contact>
  <actuator>
    <position name="base" class="arm" joint="base" ctrlrange="-1.08210414 1.08210414"/>
