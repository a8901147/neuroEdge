<mujoco model="edgeneuro_arm_hand">
  <!-- Phase 2, iteration 2: forked from mujoco_menagerie's shadow_hand/right_hand.xml
       (commit da76818e269b82289eba39808e2fb91d679d6994, Apache-2.0) plus scene
       dressing cribbed from shadow_hand/scene_right.xml. The rh_forearm subtree
       below (and everything nested inside it) is copied byte-for-byte unchanged
       from right_hand.xml (except its quat, see the note further down) -- only
       its PARENT changed, from a direct <worldbody> child (welded/fixed) to a
       new shoulder+elbow kinematic chain, so the whole arm can reach in 3D
       space instead of just tilting a fixed wrist.

       MJCF <include> can't reparent an already-defined body, so this is a text
       fork, not an include -- mesh/texture BINARY assets still resolve out of
       the untracked mujoco_menagerie/ sparse checkout via the relative meshdir
       below (they are not duplicated into this repo).

       Sensor -> DOF mapping (see PRD.md Section 3, 2026-08-22 revision): IMU#1
       (upper arm) drives shoulder pitch+roll via its own gravity-referenced
       ComplementaryFilter; IMU#2 (forearm) combined with IMU#1's pitch drives
       elbow flexion (relative angle). No magnetometer on either IMU means yaw
       is unobservable, so this only holds up for roughly single-plane arm
       motion -- an explicit, documented simplification, not a bug. This is now
       the confirmed real Phase 3 hardware sensor budget (2x MPU6050), not a
       speculative extension. -->
  <compiler angle="radian" meshdir="../../mujoco_menagerie/shadow_hand/assets" autolimits="true"/>

  <option cone="elliptic" impratio="10"/>

  <default>
    <default class="right_hand">
      <mesh scale="0.001 0.001 0.001"/>
      <joint axis="1 0 0" damping="0.05" armature="0.0002" frictionloss="0.01"/>
      <position forcerange="-1 1"/>

      <default class="wrist">
        <joint damping="0.5"/>
        <default class="wrist_y">
          <joint axis="0 1 0" range="-0.523599 0.174533"/>
          <position kp="10" ctrlrange="-0.523599 0.174533" forcerange="-10 10"/>
        </default>
        <default class="wrist_x">
          <joint range="-0.698132 0.488692"/>
          <position kp="8" ctrlrange="-0.698132 0.488692" forcerange="-5 5"/>
        </default>
      </default>

      <default class="thumb">
        <default class="thbase">
          <joint axis="0 0 -1" range="-1.0472 1.0472"/>
          <position kp="0.4" ctrlrange="-1.0472 1.0472" forcerange="-3 3"/>
        </default>
        <default class="thproximal">
          <joint range="0 1.22173"/>
          <position ctrlrange="0 1.22173" forcerange="-2 2"/>
        </default>
        <default class="thhub">
          <joint range="-0.20944 0.20944"/>
          <position kp="0.5" ctrlrange="-0.20944 0.20944"/>
        </default>
        <default class="thmiddle">
          <joint axis="0 -1 0" range="-0.698132 0.698132"/>
          <position kp="1.5" ctrlrange="-0.698132 0.698132"/>
        </default>
        <default class="thdistal">
          <joint range="-0.261799 1.5708"/>
          <position ctrlrange="-0.261799 1.5708"/>
        </default>
      </default>

      <default class="metacarpal">
        <joint axis="0.573576 0 0.819152" range="0 0.785398"/>
        <position ctrlrange="0 0.785398"/>
      </default>
      <default class="knuckle">
        <joint axis="0 -1 0" range="-0.349066 0.349066"/>
        <position ctrlrange="-0.349066 0.349066"/>
      </default>
      <default class="proximal">
