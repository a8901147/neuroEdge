    <!-- static pedestal: without support the object free-falls to the floor
         faster than the reach animation takes to arrive, so it would already
         be on the floor by the time the hand gets there. A pedestal at the
         reach pose's height lets the object sit exactly where the hand can
         grasp it while the arm is still retracted. Kept small (0.03
         half-size) so the swinging forearm/fingers are less likely to clip
         its edge mid-reach -- verified by directly stepping the simulation
         through a full reach/grip/retract cycle: a larger pedestal got
         clipped by the hand during the approach and launched the object into
         the floor; this smaller one does not. -->
    <body name="pedestal" pos="0.33 0 0.29">
      <geom type="box" size="0.03 0.03 0.03" rgba="0.6 0.5 0.4 1"/>
    </body>

    <!-- Sphere (not the original scene_right.xml ellipsoid) -- rounder
         contact geometry is more forgiving of an imperfect multi-finger
         approach angle. Mass bumped up to 0.10 (from an initial 0.02 guess)
         and friction raised: a light object launches violently on any
         glancing contact with the much-stronger arm-moving actuators
         (kp 30-40, sized for a 3kg forearm+hand, not a lightweight prop) --
         a heavier, higher-friction object absorbs incidental contact instead
         of being flung. Verified empirically: this configuration survives a
         full gradual reach -> grip -> retract cycle without the object being
         launched away. Not claimed as a perfect zero-slip pinch grasp --
         documented as an approximation in PRD.md. -->
    <body name="object" pos="0.33 0 0.34">
      <freejoint/>
      <geom type="sphere" size="0.025" rgba="0.5 0.7 0.5 1" condim="6" priority="1"
        friction="1.0 0.02 0.005" mass="0.05"/>
    </body>
  </worldbody>

